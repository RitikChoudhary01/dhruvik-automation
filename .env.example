# Public site URL, used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://dhruvik-automation.vercel.app

# Contact form delivery. Configure ONE of the two options below.
# If neither is set, the form tells the visitor that delivery is not configured
# and offers a prefilled email instead. It never pretends the message was sent.

# Option 1: Resend (https://resend.com). Server-side only, never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=
CONTACT_TO_EMAIL=choudharyritik145@gmail.com
# Must be a sender verified in Resend. "onboarding@resend.dev" only works in Resend test mode.
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Option 2: any webhook that accepts a JSON POST (an n8n Webhook node, Formspree-style endpoint, etc.)
CONTACT_WEBHOOK_URL=
